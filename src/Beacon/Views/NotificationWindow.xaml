<Window x:Class="Beacon.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1B2740" Offset="0" />
            <GradientStop Color="#0E1627" Offset="1" />
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="60" ShadowDepth="20" Opacity="0.8" />

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E8F0FF" />
            <Setter Property="Background" Value="#263450" />
            <Setter Property="BorderBrush" Value="#3B4C6C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#344663" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                             From="0.965" To="1" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                             From="0.965" To="1" Duration="0:0:0.30">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Backdrop" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChatPanel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.26" BeginTime="0:0:0.06">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChatOffset" Storyboard.TargetProperty="X"
                             From="14" To="0" Duration="0:0:0.32" BeginTime="0:0:0.04">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.97" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.97" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.19">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Backdrop" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.24">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChatPanel" Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChatOffset" Storyboard.TargetProperty="X"
                             From="0" To="12" Duration="0:0:0.20">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ReplyField" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8F1FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#8FC0FF" />
            <Setter Property="SelectionBrush" Value="#2E63A8" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="96" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ComposerSendButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="#2E63A8" />
            <Setter Property="BorderBrush" Value="#5C9BFF" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="QuickReplyButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- A passive Border instead of a Button: no hover tint and no blue
             text-selection rectangle when the mouse leaves the card. -->
        <Border x:Name="Backdrop" Background="#D5080D18" Focusable="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                MouseLeftButtonDown="Backdrop_Click" />

        <!-- Popup and chat sit side by side. Column widths and both card heights
             are recalculated from the virtual screen in code-behind, so this
             adapts to any monitor size or DPI scale. -->
        <Grid x:Name="OverlayStack" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <!-- Shifts the centered card onto the active display when more
                     than one monitor is connected (virtual-screen center can
                     land between displays). -->
                <TranslateTransform x:Name="OverlayOffset" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardColumn" Width="680" />
                <ColumnDefinition x:Name="ChatColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Card" Grid.Column="0" CornerRadius="24" BorderThickness="1"
                    BorderBrush="#3C4B68" Background="{StaticResource CardGradient}"
                    Effect="{StaticResource CardShadow}" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.92" ScaleY="0.92" />
            </Border.RenderTransform>
            <Grid>
                <Rectangle x:Name="AccentBar" Height="5" VerticalAlignment="Top" RadiusX="2" RadiusY="2"
                           Margin="28,0,28,0" Fill="#5C9BFF" />

                <ScrollViewer x:Name="ContentScroll" Style="{StaticResource ModernScrollViewer}"
                              CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="34,32,34,30">
                    <StackPanel>
                        <!-- chip row -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="KindChip" CornerRadius="7" Padding="10,5" Background="#233B60">
                                <TextBlock x:Name="KindText" Text="NOTIFICATION" FontSize="11" FontWeight="Bold"
                                           Foreground="#8FC0FF" />
                            </Border>
                            <TextBlock x:Name="SourceText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#94A6C4" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            <TextBlock x:Name="TimeText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#7186A8" HorizontalAlignment="Right" />
                        </StackPanel>

                        <!-- title row -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Border x:Name="IconBox" Width="54" Height="54" CornerRadius="15"
                                    Background="#24446E" VerticalAlignment="Center">
                                <TextBlock x:Name="IconText" Text="i" FontSize="27" FontWeight="Bold"
                                           Foreground="#9CCBFF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Segoe UI Emoji" />
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="Notification" FontSize="27" FontWeight="SemiBold"
                                           Foreground="#F4F8FF" TextWrapping="Wrap" MaxWidth="500" />
                                <TextBlock x:Name="SubtitleText" Visibility="Collapsed" Margin="0,4,0,0"
                                           FontSize="13" Foreground="#8FA5C6" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- message -->
                        <Border x:Name="WarningBanner" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="10"
                                Background="#4A2418" BorderBrush="#B4683A" BorderThickness="1" Padding="12,10">
                            <TextBlock x:Name="WarningText" FontSize="12" Foreground="#FFD8B8" TextWrapping="Wrap"
                                       Text="This will run with administrator privileges. Only approve if you trust the request." />
                        </Border>

                        <FlowDocumentScrollViewer x:Name="MessageViewer" Margin="0,20,0,0" MaxHeight="260"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  IsSelectionEnabled="False"
                                                  Foreground="#E0E8F8" />

                        <!-- code block -->
                        <Border x:Name="CodePanel" Visibility="Collapsed" Margin="0,20,0,0" CornerRadius="12"
                                Background="#0B1424" BorderBrush="#2C4E78" BorderThickness="1" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="CodeLabel" Text="Verification code" FontSize="11" FontWeight="Bold"
                                           Foreground="#7FA9D8" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                                               Foreground="#EAF4FF" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="CopyCodeButton" Grid.Column="1" Content="Copy" Style="{StaticResource PillButton}"
                                            Padding="14,7" Margin="12,0,0,0" Click="CopyCodeButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- details -->
                        <ItemsControl x:Name="DetailsList" Margin="0,18,0,0" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" FontSize="13" Foreground="#90A4C4" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" Foreground="#E4ECFB"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- image -->
                        <Border x:Name="ImagePanel" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="12"
                                Background="#0A1220" BorderBrush="#2B3D5B" BorderThickness="1" Padding="6">
                            <Image x:Name="PreviewImage" MaxHeight="220" Stretch="Uniform" />
                        </Border>

                        <!-- progress -->
                        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,20,0,0">
                            <Grid>
                                <TextBlock x:Name="ProgressLabel" FontSize="12" Foreground="#9FB4D4" />
                                <TextBlock x:Name="ProgressPercent" FontSize="12" FontWeight="Bold" Foreground="#DCE9FF"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Border Height="7" CornerRadius="4" Background="#24324B" Margin="0,8,0,0" ClipToBounds="True">
                                <Border x:Name="ProgressFill" Width="0" Height="7" CornerRadius="4" Background="#5C9BFF"
                                        HorizontalAlignment="Left" />
                            </Border>
                        </StackPanel>

                        <!-- actions -->
                        <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Margin="0,24,0,0" />

                        <TextBlock x:Name="FooterText" Visibility="Collapsed" Margin="0,18,0,0" FontSize="12"
                                   Foreground="#7086A8" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Inset, rounded progress rail so it tucks into the card instead
                     of jutting past the bottom corners. The fill width is animated
                     continuously in code-behind for a smooth countdown. -->
                <Border x:Name="CountdownTrack" Height="4" Margin="28,0,28,9"
                        VerticalAlignment="Bottom" Background="#1B2A42"
                        CornerRadius="2" ClipToBounds="True">
                    <Border x:Name="CountdownFill" Height="4" Width="0"
                            HorizontalAlignment="Left" Background="#5C9BFF"
                            CornerRadius="2" />
                </Border>
            </Grid>
        </Border>

        <!-- Small chat card docked directly under the popup. -->
        <Border x:Name="ChatPanel" Grid.Column="1" Visibility="Collapsed" Width="330"
                AutomationProperties.AutomationId="ChatPanel"
                Margin="12,0,0,0" CornerRadius="18"
                Background="#111B2D" BorderBrush="#3C4B68" BorderThickness="1"
                Effect="{StaticResource CardShadow}" Padding="0" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ChatOffset" X="14" />
            </Border.RenderTransform>
            <Grid x:Name="ChatContent" AutomationProperties.AutomationId="ChatContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16,12" BorderBrush="#263451" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                            <Border.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/muse-logo.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Muse chat" FontSize="13" FontWeight="SemiBold" Foreground="#F2F7FF" />
                            <TextBlock x:Name="ChatStatusText" Text="Live chat with Muse" FontSize="11" Foreground="#8CA3C5" />
                        </StackPanel>
                        <Ellipse x:Name="ChatStatusDot" Grid.Column="2" Width="8" Height="8" Fill="#35D49A"
                                 VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Style="{StaticResource ModernScrollViewer}"
                              MaxHeight="560" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="MuseAvatar" Width="26" Height="26" CornerRadius="13"
                                            VerticalAlignment="Top" Margin="0,2,10,0">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border x:Name="UserAvatar" Width="26" Height="26" CornerRadius="13"
                                            VerticalAlignment="Top" Margin="0,2,10,0" Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding RoleName}" FontSize="11" FontWeight="Bold"
                                                       Foreground="#9FB4D4" />
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                                       Foreground="#6D82A3" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border x:Name="Bubble" Background="#172A45" BorderBrush="#2E4464"
                                                BorderThickness="1" CornerRadius="12" Padding="12,9"
                                                MaxWidth="440" HorizontalAlignment="Left">
                                            <TextBlock FontSize="13" Foreground="#E4ECFB" TextWrapping="Wrap">
                                                <Run Text="{Binding Text}" />
                                                <!-- Inline UI flows with the text, so the caret always sits
                                                     immediately after the last character, even mid-wrap. -->
                                                <InlineUIContainer BaselineAlignment="TextBottom">
                                                    <Rectangle x:Name="StreamingCaret" Width="2" Height="14"
                                                               RadiusX="1" RadiusY="1" Margin="3,0,0,1"
                                                               Fill="#8FC0FF"
                                                               AutomationProperties.Name="StreamingCaret"
                                                               Visibility="{Binding Streaming, Converter={StaticResource BoolToVisibility}}">
                                                        <Rectangle.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.15" Duration="0:0:0.55" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Rectangle.Triggers>
                                                    </Rectangle>
                                                </InlineUIContainer>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                        <Setter TargetName="MuseAvatar" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="UserAvatar" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Bubble" Property="Background" Value="#24518B" />
                                        <Setter TargetName="Bubble" Property="BorderBrush" Value="#3F7BC5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="QuickReplyBar" Grid.Row="2" Padding="14,10" Visibility="Collapsed"
                        AutomationProperties.AutomationId="QuickReplyBar"
                        BorderBrush="#263451" BorderThickness="0,1,0,0">
                    <WrapPanel x:Name="QuickReplyPanel" VerticalAlignment="Center" />
                </Border>

                <Border x:Name="ReplyComposer" Grid.Row="3" Padding="14,10,14,18"
                        BorderBrush="#263451" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Border CornerRadius="14" Background="#0E1829" BorderBrush="#3A5A85"
                                BorderThickness="1" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="ReplyPlaceholderText" Text="Message Muse…"
                                               FontSize="13" Foreground="#6F83A3"
                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                               IsHitTestVisible="False"
                                               AutomationProperties.AutomationId="ReplyPlaceholder"
                                               AutomationProperties.Name="Message Muse…" />
                                    <TextBox x:Name="ReplyBox" Style="{StaticResource ReplyField}"
                                             AutomationProperties.AutomationId="ReplyBox"
                                             PreviewKeyDown="ReplyBox_PreviewKeyDown" />
                                </Grid>
                                <Button x:Name="SendReplyButton" Grid.Column="1" Content="Send"
                                        Style="{StaticResource ComposerSendButton}"
                                        AutomationProperties.AutomationId="SendReplyButton"
                                        Click="SendReplyButton_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="ReplyLabel" Text="Enter to send · Shift+Enter for a new line"
                                   AutomationProperties.AutomationId="ReplyLabel"
                                   FontSize="10" Foreground="#6D82A3" Margin="6,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
