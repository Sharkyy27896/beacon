<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Beacon</AssemblyName>
    <RootNamespace>Beacon.Linux</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Beacon</Product>
    <Company>Beacon</Company>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Avalonia 12 ships analyzers built by a newer Roslyn than the .NET 8 SDK. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
  </ItemGroup>

  <!-- Protocol/settings code shared with the WPF build. -->
  <ItemGroup>
    <Compile Include="../Beacon/Models/NotificationPayload.cs" Link="Models/NotificationPayload.cs" />
    <Compile Include="../Beacon/Models/Interaction.cs" Link="Models/Interaction.cs" />
    <Compile Include="../Beacon/Services/HttpServer.cs" Link="Services/HttpServer.cs" />
    <Compile Include="../Beacon/Services/PayloadParser.cs" Link="Services/PayloadParser.cs" />
    <Compile Include="../Beacon/Services/Settings.cs" Link="Services/Settings.cs" />
    <Compile Include="../Beacon/Services/NetworkHelper.cs" Link="Services/NetworkHelper.cs" />
    <Compile Include="../Beacon/Services/MonitorSelector.cs" Link="Services/MonitorSelector.cs" />
    <Compile Include="../Beacon/Services/QuickReplyLimits.cs" Link="Services/QuickReplyLimits.cs" />
    <Compile Include="../Beacon/Services/ClockFormat.cs" Link="Services/ClockFormat.cs" />
    <Compile Include="../Beacon/Services/InteractionService.cs" Link="Services/InteractionService.cs" />
    <Compile Include="../Beacon/Services/UpdateService.cs" Link="Services/UpdateService.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/beacon.png" />
    <AvaloniaResource Include="../Beacon/Assets/muse-logo.png" Link="Assets/muse-logo.png" />
  </ItemGroup>

</Project>
