<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Beacon.Installer</RootNamespace>
    <AssemblyName>Beacon.Setup</AssemblyName>
    <ApplicationIcon>../Beacon/Assets/beacon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Beacon Setup</Product>
    <Company>Beacon</Company>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

  </PropertyGroup>

  <ItemGroup>
    <Resource Include="../Beacon/Assets/beacon.ico" Link="Assets/beacon.ico" />
    <EmbeddedResource Include="Payload/BeaconPayload.zip"
                      Condition="Exists('Payload/BeaconPayload.zip')"
                      LogicalName="BeaconPayload.zip" />
  </ItemGroup>

</Project>
