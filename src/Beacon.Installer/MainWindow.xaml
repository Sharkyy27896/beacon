<Window x:Class="Beacon.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beacon Setup"
        Width="720" Height="600" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#121C2E" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#18253C" />
        <SolidColorBrush x:Key="Line" Color="#2A3B58" />
        <SolidColorBrush x:Key="Accent" Color="#5AA9FF" />
        <SolidColorBrush x:Key="TextMain" Color="#EAF2FF" />
        <SolidColorBrush x:Key="TextMuted" Color="#91A7C8" />

        <Storyboard x:Key="IntroStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                             From="0.985" To="1" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#4A8CF7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#5A9BFA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#3D7EE6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22334F" />
                                <Setter Property="Foreground" Value="{StaticResource TextMain}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathField" TargetType="TextBox">
            <Setter Property="Background" Value="#0E1727" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border x:Name="RootCard" CornerRadius="16" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX="0.985" ScaleY="0.985" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="24" ShadowDepth="4" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="24,20,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#1B2C48"
                            BorderBrush="#334A6F" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/beacon.ico" Width="24" Height="24" />
                    </Border>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               Text="Beacon Setup" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" />
                    <Border Grid.Column="2" CornerRadius="999" Padding="10,4" Background="#1B2C48"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0.1" FontSize="11" Foreground="{StaticResource Accent}" />
                    </Border>
                </Grid>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="24,4,24,0">
                    <TextBlock x:Name="Headline" Text="Install Beacon" FontSize="24"
                               FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                    <TextBlock x:Name="Subtitle" Margin="0,5,0,16" FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               Text="Set up Beacon on this PC. Your existing settings are kept." />

                    <Border CornerRadius="12" Padding="16,14" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DESTINATION" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock x:Name="PathText" Grid.Row="0" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CURRENT VERSION" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                            <TextBlock x:Name="InstalledText" Grid.Row="1" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="APP DATA" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,10,0,0" />
                            <TextBlock x:Name="DataText" Grid.Row="2" Grid.Column="1" FontSize="12.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Button x:Name="AdvancedToggle" Content="Advanced options  +" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Padding="8,0" Margin="0,12,0,0"
                            Click="AdvancedToggle_Click" />

                    <Border x:Name="AdvancedPanel" Visibility="Collapsed" CornerRadius="12" Padding="14,12"
                            Margin="0,8,0,0" Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="AdvancedOffset" Y="-6" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <TextBlock Text="Installation folder" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Style="{StaticResource PathField}" />
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Padding="12,0" Click="BrowseInstall_Click" />
                            </Grid>

                            <TextBlock Text="App data folder" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,12,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataPathBox" Style="{StaticResource PathField}" />
                                <Button Grid.Column="1" Content="Browse" Style="{StaticResource GhostButton}"
                                        Margin="8,0,0,0" Padding="12,0" Click="BrowseData_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,18,0,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                       Text="Waiting" />
                            <TextBlock x:Name="PercentText" FontSize="12.5" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Border CornerRadius="4" Background="#1B2B46" ClipToBounds="True">
                                        <Grid x:Name="PART_Track">
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#5AA9FF" Offset="0" />
                                                        <GradientStop Color="#7FD4FF" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                    </StackPanel>
                </StackPanel>

                <!-- Footer / buttons -->
                <Grid Grid.Row="2" Margin="24,12,24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Beacon 1.0.1" FontSize="11" Foreground="#61769A"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButton}"
                                Margin="0,0,8,0" Click="CancelButton_Click" />
                        <Button x:Name="RepairButton" Content="Repair" Style="{StaticResource GhostButton}"
                                Visibility="Collapsed" Margin="0,0,8,0"
                                ToolTip="Reinstall Beacon at 1.0.1"
                                Click="RepairButton_Click" />
                        <Button x:Name="PrimaryButton" Content="Install" Style="{StaticResource PrimaryButton}"
                                Click="PrimaryButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
