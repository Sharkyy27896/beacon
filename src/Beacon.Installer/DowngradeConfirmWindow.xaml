<Window x:Class="Beacon.Installer.DowngradeConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm downgrade"
        Width="470" Height="250" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Border CornerRadius="14" Background="#121C2E" BorderBrush="#2A3B58" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="22" ShadowDepth="4" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0">
                <TextBlock Text="Downgrade Beacon?" FontSize="18" FontWeight="SemiBold"
                           Foreground="#EAF2FF" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="#EAF2FF"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#91A7C8"
                           TextWrapping="Wrap"
                           Text="Your settings and app-data folder are kept. The newer installation will be replaced." />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}"
                        Margin="0,0,10,0" />
                <Button Content="Continue" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Click="Continue_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
